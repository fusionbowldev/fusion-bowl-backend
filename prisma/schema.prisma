generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Category {
  BASE
  PREMIUM
  EXOTIC
}

enum OrderStatus {
  PLACED
  CONFIRMED
  OUT_FOR_DELIVERY
  DELIVERED
}

enum AdminRole {
  SUPER_ADMIN
  SUB_ADMIN
}

model Product {
  id              String   @id @default(uuid())
  name            String
  category        Category

  isPerishable    Boolean  @default(true)
  
  imageUrl        String

  benefits        Json
  storageTips     Json
  consumptionTips Json
  tags            Json

  isActive        Boolean  @default(true)

  inventories     Inventory[]
  cartItems       Cart[]
  orderItems      OrderItem[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([category])
}

model Inventory {
  id                   String   @id @default(uuid())

  productId            String
  city                 String

  availableQuantity    Float    @default(0)

  costPrice            Float
  transportCost        Float
  storageCost          Float

  mrp                  Float
  discountPercentage   Float    @default(0)

  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id])

  @@unique([productId, city])
}

model User {
  id          String   @id @default(uuid())
  phoneNumber String   @unique

  createdAt   DateTime @default(now())

  carts       Cart[]
  orders      Order[]

  @@index([phoneNumber])
}

model Cart {
  id        String   @id @default(uuid())
  userId    String
  productId String
  quantity  Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  @@unique([userId, productId])
  @@index([userId])
}

model Order {
  id               String   @id @default(uuid())

  userId           String

  status           OrderStatus

  subtotal         Float
  handlingCharge   Float
  deliveryCharge   Float

  finalPayable     Float

  totalPrice       Float

  city             String

  address          String
  phone            String

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])

  items OrderItem[]
}

model OrderItem {
  id                   String @id @default(uuid())

  orderId              String
  productId            String

  quantity             Float

  // snapshot data
  productName          String
  productImageUrl      String

  mrp                  Float
  discountPercentage   Float

  sellingPrice         Float

  // backward compatibility
  price                Float

  order Order @relation(fields: [orderId], references: [id])

  product Product @relation(fields: [productId], references: [id])
}

model Admin {
  id        String    @id @default(uuid())
  name      String
  email     String    @unique
  password  String

  role      AdminRole

  createdAt DateTime @default(now())

  @@index([email])
}